--- a/iokit/Kernel/arm/XCover5MMCProbe.h
+++ b/iokit/Kernel/arm/XCover5MMCProbe.h
@@ -4,6 +4,9 @@
 static vm_offset_t mmio;
 static IOLock *media_lock;
 static uint32_t media_sectors;
+/* Protected by media_lock. Transfer ticks exclude lock acquisition, but can
+ * include preemption; these are elapsed times, not CPU consumption. */
+static uint64_t perf_reads, perf_errors, perf_ticks;
 static uint32_t rd(unsigned o) { return *(volatile uint32_t *)(mmio+o); }
 static void wr(unsigned o,uint32_t v) {
     *(volatile uint32_t *)(mmio+o)=v;
@@ -120,8 +123,22 @@
  if(!media_lock || lba>=media_sectors)return -1;
  IOLockLock(media_lock);
  struct result r;
+ uint64_t begin=mach_absolute_time();
  int rc=transfer((uint8_t *)buffer,17,lba,&r);
  if(r.response&0xfdffa080U)rc=-1;
+ perf_ticks+=mach_absolute_time()-begin;
+ perf_reads++;
+ if(rc)perf_errors++;
  IOLockUnlock(media_lock);
  return rc;
 }
+
+/* Snapshot only; never print while holding the storage lock. */
+extern "C" void xcover5_mmc_perf(uint64_t *reads,uint64_t *errors,uint64_t *ticks) {
+ using namespace xcover5_mmc;
+ *reads=*errors=*ticks=0;
+ if(!media_lock)return;
+ IOLockLock(media_lock);
+ *reads=perf_reads;*errors=perf_errors;*ticks=perf_ticks;
+ IOLockUnlock(media_lock);
+}
