+/* Bounded observation only: no target suspend/resume, signals or user memory. */
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/spl.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static boolean_t sweet_wait_started;
+
+static void
+sweet_wait_process(int pid)
+{
+ /* proc_find can wait for an exec transition. Delimit lookup so a blocked
+  * observer cannot be mistaken for a completed sample or an absent process. */
+ printf("XCOVER5 WAIT LOOKUP pid=%d\n", pid);
+ proc_t p = proc_find(pid);
+ if (p == PROC_NULL) {
+  printf("XCOVER5 WAIT GONE pid=%d\n", pid);
+  return;
+ }
+ char name[MAXCOMLEN + 1];
+ proc_lock(p);
+ strlcpy(name, p->p_comm, sizeof(name));
+ proc_unlock(p);
+ task_t task = proc_task(p);
+ if (task != TASK_NULL) task_reference(task);
+ proc_rele(p);
+ if (task == TASK_NULL) {
+  printf("XCOVER5 WAIT NO_TASK pid=%d name=%s\n", pid, name);
+  return;
+ }
+ /* Try the task mutex: diagnosis must not wait behind the target's task lock.
+  * Hold thread references after dropping it; never print under either lock. */
+ if (!task_lock_try(task)) {
+  printf("XCOVER5 WAIT TASK_BUSY pid=%d name=%s\n", pid, name);
+  task_deallocate(task);
+  return;
+ }
+ thread_t threads[8], th;
+ unsigned int count = 0, total = task->thread_count;
+ boolean_t active = task->active;
+ queue_iterate(&task->threads, th, thread_t, task_threads) {
+  if (count == 8) break;
+  thread_reference(th);
+  threads[count++] = th;
+ }
+ task_unlock(task);
+ printf("XCOVER5 WAIT PROC pid=%d name=%s active=%d threads=%u shown=%u\n",
+     pid, name, active, total, count);
+ for (unsigned int i = 0; i < count; i++) {
+  th = threads[i];
+  spl_t level = splsched();
+  thread_lock(th);
+  uint64_t tid = th->thread_id, event = th->wait_event;
+  uint64_t cont = (uintptr_t)th->continuation, last_run = th->last_run_time;
+  int state = th->state, hint = th->block_hint, pri = th->sched_pri;
+  unsigned int switches = th->c_switch;
+  unsigned int unix_calls = th->syscalls_unix, mach_calls = th->syscalls_mach;
+  thread_unlock(th);
+  splx(level);
+  thread_deallocate(th);
+  printf("XCOVER5 WAIT TH pid=%d tid=%llu state=%x hint=%x pri=%d csw=%u\n",
+      pid, (unsigned long long)tid, state, hint, pri, switches);
+  printf("XCOVER5 WAIT AT event=%llx cont=%llx last=%llx unix=%u mach=%u\n",
+      (unsigned long long)event, (unsigned long long)cont,
+      (unsigned long long)last_run, unix_calls, mach_calls);
+ }
+ task_deallocate(task);
+}
+
+static void
+sweet_wait_worker(void *arg, wait_result_t result)
+{
+ (void)arg; (void)result;
+ /* Four observations, at 20-second intervals after PID1's Apple image load.
+  * A running kernel observer is evidence only about these samples. */
+ for (unsigned int round = 1; round <= 4; round++) {
+  assert_wait_timeout((event_t)&sweet_wait_started, THREAD_UNINT, 20, NSEC_PER_SEC);
+  thread_block(THREAD_CONTINUE_NULL);
+  int pids[64]; unsigned int count = 0;
+  lck_spin_lock(&sweet_diag_lock);
+  for (int pid = 1; pid < 64; pid++) {
+   struct sweet_diag_slot *slot = &sweet_diag_slots[pid];
+   boolean_t selected = (pid == 1);
+   /* Only PID1 and the launchd/proof chain, not every prior regression. */
+   for (unsigned int i = 0; i < slot->count; i++) {
+    struct sweet_diag_event *e = &slot->events[i];
+    if (e->kind == 1 && (!strcmp(e->file, "xpcproxy") ||
+        !strcmp(e->file, "m35-proof"))) selected = TRUE;
+   }
+   if (selected) pids[count++] = pid;
+  }
+  lck_spin_unlock(&sweet_diag_lock);
+  printf("XCOVER5 WAIT ROUND=%u [state 1=WAIT 2=SUSP 4=RUN 8=UNINT; hint 2/3=IPC a=ULOCK b=MUTEX f=WORKQ]\n", round);
+  for (unsigned int i = 0; i < count; i++) sweet_wait_process(pids[i]);
+  printf("XCOVER5 WAIT END=%u\n", round);
+ }
+ printf("XCOVER5 WAIT DONE: four samples; no execution success implied\n");
+ thread_terminate_self();
+}
+
+static void
+sweet_wait_start(void)
+{
+ lck_spin_lock(&sweet_diag_lock);
+ boolean_t start = !sweet_wait_started;
+ sweet_wait_started = TRUE;
+ lck_spin_unlock(&sweet_diag_lock);
+ if (!start) return;
+ thread_t worker = THREAD_NULL;
+ kern_return_t kr = kernel_thread_start(sweet_wait_worker, NULL, &worker);
+ printf("XCOVER5 WAIT START kr=%d interval=20 rounds=4\n", kr);
+ if (kr == KERN_SUCCESS) thread_deallocate(worker);
+}
+#endif
