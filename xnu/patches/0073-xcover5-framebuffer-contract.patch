+    unsigned map_ok = xc_fb_stage == 4 && fbcon_base != NULL;
+    unsigned checked = 0;
+    if (map_ok) {
+        uint64_t va = (uint64_t)(uintptr_t)fbcon_base;
+        for (uint64_t off = 0; off < xc_fb.used; off += PAGE_SIZE) {
+            ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)(va + off));
+            if (!page || ((uint64_t)page << PAGE_SHIFT) != xc_fb.physical + off) {
+                map_ok = 0; break;
+            }
+            checked++;
+        }
+    }
+    kprintf("XCOVER5 M42 FB stage=%u map_ok=%u pages=%u\n", xc_fb_stage, map_ok, checked);
