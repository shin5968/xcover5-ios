--- /dev/null
+++ b/security/xcover5_prefs_access.h
@@ -0,0 +1,27 @@
+/* Scoped bring-up contract for the self preference-read query observed in M39K.
+ * Pinned HackiOS minisandbox allows call2; restrict this fallback to the exact
+ * root actors, operation, ABI flags/filter, live self PID and PID version.
+ * This does not implement a general Sandbox or change a registered policy.
+ */
+#ifndef XCOVER5_PREFS_ACCESS_H
+#define XCOVER5_PREFS_ACCESS_H
+static int
+xcover5_preferences_access(proc_t p,user_addr_t address)
+{
+    struct { uint64_t result,pid,operation,filter_type,filter,flags,pidversion; } a;
+    char operation[64];size_t length;
+    uint64_t decision=0;
+    int error;
+    if(proc_getuid(p)!=0 || !proc_is64bit_data(p) ||
+        (strcmp(p->p_comm,"m39-probe") && strcmp(p->p_comm,"cfprefsd")))return ENOPOLICY;
+    error=copyin(address,&a,sizeof(a));if(error)return error;
+    if(a.pid!=(uint64_t)proc_pid(p) || a.pidversion!=(uint64_t)proc_pidversion(p) ||
+        a.flags!=0x40000011ULL || a.filter_type!=28)return ENOPOLICY;
+    error=copyinstr(a.operation,operation,sizeof(operation),&length);if(error)return error;
+    if(strcmp(operation,"user-preference-read"))return ENOPOLICY;
+    /* Filter28's payload is not dereferenced: its type was not established. */
+    error=copyout(&decision,a.result,sizeof(decision));
+    printf("XCOVER5 M39L PREF_READ pid=%d v=%d rc=%d\n",proc_pid(p),proc_pidversion(p),error);
+    return error;
+}
+#endif
