--- /dev/null
+++ b/bsd/kern/xcover5_m38c.c
@@ -0,0 +1,42 @@
+/* Append-only, bounded bring-up evidence. No allocation or panic-time locks. */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <kern/debug.h>
+#include <os/atomic_private.h>
+#include "xcover5_m38c.h"
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#define TRACE_CAP 256
+struct trace_event { unsigned int ready, kind; int pid; unsigned int a,b,c; char name[24]; unsigned char hash[20]; };
+static struct trace_event events[TRACE_CAP];
+static unsigned int reserved;
+void xcover5_m38c_dump(void);
+void
+xcover5_m38c_record(unsigned int kind, int pid, unsigned int a, unsigned int b,
+    unsigned int c, const char *name, const unsigned char *hash)
+{
+    unsigned int i = os_atomic_inc_orig(&reserved, relaxed);
+    if (i >= TRACE_CAP) return;
+    struct trace_event *e = &events[i];
+    e->kind=kind; e->pid=pid; e->a=a; e->b=b; e->c=c;
+    if (name) strlcpy(e->name,name,sizeof(e->name));
+    if (hash) memcpy(e->hash,hash,20);
+    os_atomic_store(&e->ready,1,release);
+}
+void
+xcover5_m38c_dump(void)
+{
+    unsigned int total=os_atomic_load(&reserved,acquire);
+    unsigned int n=total < TRACE_CAP ? total : TRACE_CAP;
+    paniclog_append_noflush("\nXCOVER5 M38C RETAINED count=%u overflow=%u [1=enter 2=status 3=return 4=signature 5=load]\n",n,total>TRACE_CAP);
+    unsigned int start=n>16?n-16:0;
+    for (unsigned int i=start;i<n;i++) {
+        struct trace_event *e=&events[i];
+        if (!os_atomic_load(&e->ready,acquire)) continue;
+        paniclog_append_noflush("M38C %u k%u pid%d %s a=%x b=%x c=%x\n",i,e->kind,e->pid,e->name,e->a,e->b,e->c);
+        if (e->kind==4 || e->kind==5) {
+            paniclog_append_noflush("HASH %02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n",
+                e->hash[0],e->hash[1],e->hash[2],e->hash[3],e->hash[4],e->hash[5],e->hash[6],e->hash[7],e->hash[8],e->hash[9],e->hash[10],e->hash[11],e->hash[12],e->hash[13],e->hash[14],e->hash[15],e->hash[16],e->hash[17],e->hash[18],e->hash[19]);
+        }
+    }
+}
+#endif
