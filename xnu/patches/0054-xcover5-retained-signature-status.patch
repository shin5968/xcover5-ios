@@ -0,0 +1,5 @@
+/* Bounded diagnostic records only; no signing decisions. */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+void xcover5_m38c_record(unsigned int kind, int pid, unsigned int a,
+    unsigned int b, unsigned int c, const char *name, const unsigned char *hash);
