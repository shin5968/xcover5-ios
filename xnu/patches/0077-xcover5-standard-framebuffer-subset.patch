+ for(unsigned i=1;i<4;i++)if(xc_fb_word(b,0x54+4*i))return false;
+ if(xc_fb_word(b,0x104)!=1 || xc_fb_word(b,0x108))return false;
+ const uint32_t src[4]={0,0,64,32},dst[4]={232,676,256,128};
+ for(unsigned i=0;i<4;i++)if(xc_fb_word(b,0x64+4*i)!=src[i] || xc_fb_word(b,0xc4+4*i)!=dst[i])return false;
+ return true;
+}
