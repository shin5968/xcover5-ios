+#ifndef XCOVER_FRAMEBUFFER_ABI_H
+#define XCOVER_FRAMEBUFFER_ABI_H
+static uint32_t xc_fb_word(const uint8_t *b,unsigned off){uint32_t v;memcpy(&v,b+off,4);return v;}
+static bool xc_fb_swap_valid(const uint8_t *b,size_t n,uint32_t issued) {
+ if(!b || n!=0x46c || !issued || issued>2 || xc_fb_word(b,0x50)!=issued) return false;
