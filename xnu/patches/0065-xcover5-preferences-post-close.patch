+/* M39N: bounded HackiOS call12 fallback for the observed preference caller.
+ * Wire ABI: sign-extended int32 slot + uint64 flags, no output pointer.
+ * CFPDSource may close the opened descriptor at0x186e98ab4 BEFORE call12
+ * at0x186e98b34. A new live-FD/vnode/path prerequisite is therefore invalid.
+ * This bring-up fallback does not implement full Apple Sandbox semantics.
+ */
+#ifndef XCOVER5_PREFS_PASSTHROUGH_H
+#define XCOVER5_PREFS_PASSTHROUGH_H
+static int
+xcover5_prefs_passthrough(proc_t p,user_addr_t address)
+{
+    struct { uint64_t arg0,flags; } a;
+    int error;
+    if(proc_getuid(p)!=0 || !proc_is64bit_data(p) ||
+        (strcmp(p->p_comm,"m39-probe") && strcmp(p->p_comm,"cfprefsd")))return ENOPOLICY;
+    error=copyin(address,&a,sizeof(a));if(error)return error;
+    if(a.arg0>0x7fffffffULL || a.flags!=0x102)return ENOPOLICY;
+    printf("XCOVER5 M39N PASSTHROUGH pid=%d arg0=%llu flags=%llx rc=0\n",
+        proc_pid(p),a.arg0,a.flags);
+    return 0;
+}
+#endif
