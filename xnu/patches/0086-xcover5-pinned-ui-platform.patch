+/* M56: exact locally verified iOS16.5 UI CodeDirectories only.
+ * Called after successful signature validation; page checks remain active.
+ * No process name, path, or caller-controlled identity is accepted here. */
+static inline unsigned int
+xcover5_ui_platform(const unsigned char *cdhash,unsigned int cs_flags,unsigned int platform)
+{
+    static const unsigned char expected[2][20] = {
+        {0x45,0x3a,0xe2,0xe6,0x05,0x7a,0xcb,0x2d,0xea,0x0c,0x5a,0xe8,0xba,0x09,0x73,0x07,0x7e,0xa3,0xea,0xb1},
+        {0x11,0x62,0x7e,0xea,0x9a,0x12,0x6a,0x45,0xb9,0xa2,0xb4,0xab,0xd3,0x1d,0x6c,0xaf,0xd5,0x9d,0x71,0x44}
+    };
+    if(cdhash==0 || platform!=2 || !(cs_flags&2))return 0;
+    for(unsigned int row=0;row<2;row++) {
+        unsigned int different=0;
+        for(unsigned int i=0;i<20;i++)different|=cdhash[i]^expected[row][i];
+        if(!different)return row+1;
+    }
+    return 0;
+}
