+#if defined(XCOVER5)
+/* Exact 64x32 BGRA input, nearest-neighbour 4x into a centered 256x128 rectangle.
+ * Buffer sizes are fixed; caller owns valid kernel memory. No user pointer/MMIO. */
+int xcover5_present_begin(const uint32_t *pixels, uint32_t *saved)
+{
+    if (!pixels || !saved || xc_fb_stage != 4 || !fbcon_base ||
+        !xc_fb_layout_valid(&xc_fb) || xc_fb.width < 256 || xc_fb.height < 128) return 1;
+    uint64_t va = (uint64_t)(uintptr_t)fbcon_base;
+    for (uint64_t off = 0; off < xc_fb.used; off += PAGE_SIZE) {
+        ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)(va + off));
+        if (!page || ((uint64_t)page << PAGE_SHIFT) != xc_fb.physical + off) return 2;
+    }
+    boolean_t enabled = xc_fb_lock();
+    if (xc_fb_presenting) { xc_fb_unlock(enabled); return 3; }
+    xc_fb_presenting = 1;
+    uint32_t x0 = (xc_fb.width - 256) / 2, y0 = (xc_fb.height - 128) / 2;
+    for (uint32_t y = 0; y < 128; y++) {
+        volatile uint32_t *line = fbcon_base + (y0 + y) * (xc_fb.stride / 4) + x0;
+        for (uint32_t x = 0; x < 256; x++) {
+            saved[y * 256 + x] = line[x];
+            line[x] = pixels[(y / 4) * 64 + x / 4];
+        }
+    }
+    __sync_synchronize();
+    xc_fb_unlock(enabled);
+    return 0;
+}
+int xcover5_present_end(const uint32_t *saved)
+{
+    if (!saved) return 1;
+    boolean_t enabled = xc_fb_lock();
+    if (!xc_fb_presenting) { xc_fb_unlock(enabled); return 2; }
+    uint32_t x0 = (xc_fb.width - 256) / 2, y0 = (xc_fb.height - 128) / 2;
+    unsigned mismatch = 0;
+    for (uint32_t y = 0; y < 128; y++) {
+        volatile uint32_t *line = fbcon_base + (y0 + y) * (xc_fb.stride / 4) + x0;
+        for (uint32_t x = 0; x < 256; x++) line[x] = saved[y * 256 + x];
+        for (uint32_t x = 0; x < 256; x++) mismatch |= line[x] != saved[y * 256 + x];
+    }
+    __sync_synchronize();
+    xc_fb_presenting = 0;
+    xc_fb_unlock(enabled);
+    return mismatch ? 3 : 0;
+}
+#endif
