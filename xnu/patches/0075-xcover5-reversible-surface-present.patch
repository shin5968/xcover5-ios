+#if defined(XCOVER5)
+static volatile unsigned xc_fb_draw_lock;
+static unsigned xc_fb_presenting;
+static boolean_t xc_fb_lock(void) {
+    boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+    while (__sync_lock_test_and_set(&xc_fb_draw_lock, 1)) { }
+    return enabled;
+}
+static void xc_fb_unlock(boolean_t enabled) {
+    __sync_lock_release(&xc_fb_draw_lock);
+    ml_set_interrupts_enabled(enabled);
+}
+#endif
