+extern "C" int xcover5_present_begin(const uint32_t *, uint32_t *);
+extern "C" int xcover5_present_end(const uint32_t *);
+extern "C" void xcover5_present_test(void)
+{
+    static bool attempted;
+    if (attempted) return;
+    attempted = true;
+    if (!gSurfaceLock) { IOLog("XCOVER5 M44 FAIL service_unavailable\n"); return; }
+    IOLockLock(gSurfaceLock);
+    bool clean = gSurfaceCount == 0;
+    IOLockUnlock(gSurfaceLock);
+    if (!clean) { IOLog("XCOVER5 M44 FAIL baseline_surfaces_live\n"); return; }
+    MiniIOSurface *s = MiniIOSurfaceCreateSimple(64, 32, 'BGRA');
+    uint32_t *saved = (uint32_t *)IOMalloc(256U * 128U * 4U);
+    if (!s || !saved) {
+        if (s) MiniIOSurfaceDrop(s);
+        if (saved) IOFree(saved, 256U * 128U * 4U);
+        IOLog("XCOVER5 M44 FAIL allocation\n"); return;
+    }
+    const uint32_t colors[8] = {0xffff0000U,0xff00ff00U,0xff0000ffU,0xffffffffU,
+        0xff00ffffU,0xffff00ffU,0xffffff00U,0xff000000U};
+    uint32_t *pixels = (uint32_t *)s->kpixels;
+    for (unsigned y=0;y<32;y++) for (unsigned x=0;x<64;x++) pixels[y*64+x]=colors[x/8];
+    IOLog("XCOVER5 M44 BEGIN kernel IOSurface bars R G B W C M Y K, centered256x128 hold2000ms\n");
+    int begin = xcover5_present_begin(pixels, saved), restored = -1;
+    if (!begin) { IOSleep(2000); restored = xcover5_present_end(saved); }
+    IOFree(saved, 256U * 128U * 4U);
+    MiniIOSurfaceDrop(s);
+    IOLog("XCOVER5 M44 %s begin=%d restored=%d source=kernel_IOSurface visual=USER_VERIFY\n",
+        !begin && !restored ? "COPY_RESTORE_PASS" : "FAIL", begin, restored);
+}
+
 #endif /* XCOVER5 */
