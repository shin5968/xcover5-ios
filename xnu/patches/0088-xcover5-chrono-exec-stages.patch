--- /dev/null
+++ b/bsd/kern/xcover5_exec_stage.h
@@ -0,0 +1,30 @@
+/* M58 read-only exec stages for one exact kernel-copied path.
+ * No user memory access, allocation, retained pointers, or authorization changes. */
+#ifndef XCOVER5_EXEC_STAGE_H
+#define XCOVER5_EXEC_STAGE_H
+#if defined(XCOVER5)
+static int xcover5_exec_stage_target(const struct image_params *imgp) {
+ static const char target[]="/System/Library/PrivateFrameworks/ChronoCore.framework/Support/chronod";
+ const size_t prefix=sizeof(EXECUTABLE_KEY)-1;
+ if(!imgp || !imgp->ip_strings || !imgp->ip_strendp)return 0;
+ uintptr_t start=(uintptr_t)imgp->ip_strings,end=(uintptr_t)imgp->ip_strendp;
+ if(end<start || end-start<prefix+sizeof target || end-start>NCARGS+PAGE_SIZE)return 0;
+ return !memcmp(imgp->ip_strings,EXECUTABLE_KEY,prefix) && !memcmp(imgp->ip_strings+prefix,target,sizeof target);
+}
+static void xcover5_exec_stage(struct image_params *imgp,const char *stage,int result) {
+ if(!xcover5_exec_stage_target(imgp))return;
+ proc_t p=vfs_context_proc(imgp->ip_vfs_context);
+ printf("XCOVER5 M58 EXEC stage=%s rc=%d pid=%d uid=%u flags=%x\n",stage,result,proc_getpid(p),(unsigned)kauth_cred_getuid(vfs_context_ucred(imgp->ip_vfs_context)),(unsigned)imgp->ip_flags);
+}
+static void xcover5_exec_stage_attrs(struct image_params *imgp) {
+ if(!xcover5_exec_stage_target(imgp))return;
+ struct vnode_attr *a=imgp->ip_vattr;
+ printf("XCOVER5 M58 ATTR mode=%o owner=%u group=%u bytes=%llu mount=%llx\n",(unsigned)a->va_mode,(unsigned)a->va_uid,(unsigned)a->va_gid,(unsigned long long)a->va_data_size,(unsigned long long)imgp->ip_vp->v_mount->mnt_flag);
+}
+#define XC58_STAGE(image,stage,result) xcover5_exec_stage(image,stage,result)
+#define XC58_ATTRS(image) xcover5_exec_stage_attrs(image)
+#else
+#define XC58_STAGE(image,stage,result) ((void)0)
+#define XC58_ATTRS(image) ((void)0)
+#endif
+#endif
