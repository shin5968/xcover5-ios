+/* M48A: bounded M40 readiness evidence, independent of submission state. */
+static uint64_t gM40Diag[13];
+static bool xcM40DiagValid(const uint64_t *v,uint32_t n) {
+    return v && n==12 && v[0]>0 && v[0]<=0x7fffffffULL && v[1]<=10 &&
+        (v[2]=='R' || v[2]=='B' || v[2]=='D') &&
+        (v[3]==0xffffffffULL || v[3]<=1) && v[4]<=1024 && v[5]<=0xffff &&
+        (v[6]==0xffffffffULL || v[6]<=2) && v[7]<=1024 && v[8]<=255 &&
+        (v[9]==1 || v[9]==2) && v[10]<=7 && v[11]==0;
+}
+static void xcM40DiagReport(void) {
+    uint64_t v[13];IOLockLock(gSurfaceLock);memcpy(v,gM40Diag,sizeof(v));IOLockUnlock(gSurfaceLock);
+    if(!v[0])return;
+    IOLog("XCOVER5 M48A WAIT parent=%llu child=%llu phase=%llu expected=%llu flags=%llu\n",v[0],v[1],v[2],v[3],v[11]);
+    IOLog("XCOVER5 M48A POLL rc=%llx errno=%llu revents=%llx\n",v[4],v[5],v[6]);
+    IOLog("XCOVER5 M48A READ rc=%llx errno=%llu got=%llu reason=%llu FINAL\n",v[7],v[8],v[9],v[10]);
+}
