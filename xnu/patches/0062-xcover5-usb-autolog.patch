+extern ppnum_t pmap_find_phys(pmap_t,addr64_t);
+static unsigned int xc_capture_lock;
+static unsigned long xc_enter(void) {
+    boolean_t enabled=ml_set_interrupts_enabled(FALSE);
+    while(!os_atomic_cmpxchg(&xc_capture_lock,0,1,acquire)) {__asm__ volatile("yield");}
+    return enabled;
+}
+static void xc_leave(unsigned long enabled) {
+    os_atomic_store(&xc_capture_lock,0,release);
+    ml_set_interrupts_enabled((boolean_t)enabled);
+}
+#include "xcover5_auto_capture.h"
+void xcover5_log_byte(uint8_t c);
+void xcover5_autolog_init(void);
+void xcover5_test_finish(proc_t p,int rv);
+void xcover5_log_byte(uint8_t c) {xc_capture(c);}
+void xcover5_test_finish(proc_t p,int rv) {
+    if(proc_getuid(p)!=0 || proc_ppid(p)!=1 || strcmp(p->p_comm,"m39-probe"))return;
+    printf("XCOVER5 AUTO TEST_END pid=%d wait_status=%x\n",proc_getpid(p),rv);
+    xc_finish(mach_absolute_time(),(uint32_t)rv);
+    printf("XCOVER5 AUTO SNAPSHOT bytes=%u crc=%08x dropped=%u; awaiting PC ACK\n",
+        xc_meta.size,xc_meta.crc,xc_meta.dropped);
+}
+static uint32_t usb_rd(vm_offset_t b,uint32_t off) {
+    uint32_t v=*(volatile uint32_t *)(b+off);
+    __asm__ volatile("dmb oshld" ::: "memory");return v;
+}
+static void board_wr(vm_offset_t b,uint32_t off,uint32_t v) {
+    *(volatile uint32_t *)(b+off)=v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static void xcover5_download_reset(void) {
+    int enabled=0;PE_parse_boot_argn("xcautoreset",&enabled,sizeof(enabled));
+    if(!enabled || !xc_meta.ready || !xc_acknowledged || xc_meta.dropped){
+        printf("XCOVER5 AUTO: reset not armed\n");return;
+    }
+    vm_offset_t pmu=ml_io_map(0x11860000,0x4000);
+    if(!pmu){printf("XCOVER5 AUTO: reset PMU map failed\n");return;}
+    printf("XCOVER5 AUTO: PC acknowledged snapshot; download reset\n");
+    /* sec_reboot: normal LPM magic, download reason; exynos reboot-v1:
+     * SYSIP_DAT0 normal (sw reset), SYSTEM_CONFIGURATION SWRESET bit1.
+     * No power-off, storage, partition or bootloader image writes. */
+    ml_set_interrupts_enabled(FALSE);
+    uint32_t magic=usb_rd(pmu,0x808);
+    board_wr(pmu,0x808,(magic&~(0xffU<<16))|(0x4eU<<16));
+    board_wr(pmu,0x80c,0x12345601);
+    board_wr(pmu,0x810,0);
+    board_wr(pmu,0x3a00,2);
+    /* A failed reset never proceeds into another device operation. */
+    for(;;){__asm__ volatile("wfe");}
+}
+static void xcover5_usb_gadget_start(vm_offset_t);
+void xcover5_autolog_init(void) {
+    int enabled=0;PE_parse_boot_argn("xcautousb",&enabled,sizeof(enabled));
+    if(!enabled)return;
+    vm_offset_t pmu=ml_io_map(0x11860000,0x4000);
+    if(!pmu)return;
+    uint32_t power=usb_rd(pmu,0x1c84);
+    printf("XCOVER5 AUTO USB: HSI power status=%08x\n",power);
+    /* Exynos3830 flexpmu hsi_status/hsi_on use mask BIT(0), not 0xf. */
+    if(!(power&1U)){printf("XCOVER5 AUTO USB: STOP HSI power off\n");return;}
+    vm_offset_t cmu=ml_io_map(0x13400000,0x4000);
+    if(!cmu)return;
+    uint32_t phy=usb_rd(cmu,0x203c),bus=usb_rd(cmu,0x2040);
+    uint32_t ref50=usb_rd(cmu,0x200c),ref26=usb_rd(cmu,0x2010);
+    printf("XCOVER5 AUTO USB: gates phy=%08x bus=%08x ref50=%08x ref26=%08x\n",phy,bus,ref50,ref26);
+    if(!(phy&(1U<<21)) || !(bus&(1U<<21)) || !(ref26&(1U<<21))){
+        printf("XCOVER5 AUTO USB: STOP bootloader clocks not retained\n");return;
+    }
+    vm_offset_t dwc=ml_io_map(0x13600000,0x10000);
+    if(!dwc)return;
+    uint32_t id=usb_rd(dwc,0xc120);
+    printf("XCOVER5 AUTO USB: DWC3 id=%08x GCTL=%08x PHYCFG=%08x\n",id,usb_rd(dwc,0xc110),usb_rd(dwc,0xc200));
+    if((id&0xffff0000U)!=0x55330000U){printf("XCOVER5 AUTO USB: STOP unknown controller\n");return;}
+    xcover5_usb_gadget_start(dwc);
+}
+
+#define GCTL            0xc110
+#define GUSB2PHYCFG     0xc200
+#define USB2_CMD_SLEEP  ((1u << 6) | (1u << 8)) /* SUSPHY | ENBLSLPM */
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_SIZE         0x4000
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+    uint8_t request;
+    uint16_t expected;
+    unsigned reset_ticks;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	/* USB2-only gadget: Samsung dwc3_send_gadget_ep_cmd saves/clears both
+	 * PHY sleep bits before every command, including after core soft reset.
+	 * Clearing SUSPHY once before reset does not enforce that contract. */
+	uint32_t phy = dwc_rd(GUSB2PHYCFG);
+	uint32_t saved = phy & USB2_CMD_SLEEP;
+	int result = -1;
+	if (saved) {
+		dwc_wr(GUSB2PHYCFG, phy & ~USB2_CMD_SLEEP);
+	}
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("XCOVER5 AUTO USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				goto done;
+			}
+			result = 0;
+			goto done;
+		}
+		delay(1);
+	}
+	printf("XCOVER5 AUTO USB: ep%u cmd 0x%x timeout reg=%08x PHY=%08x saved=%08x DSTS=%08x\n",
+	    ep, cmd & 0xf, dwc_rd(DEPCMD(ep)), dwc_rd(GUSB2PHYCFG), saved, dwc_rd(DSTS));
+done:
+	if (saved) {
+		dwc_wr(GUSB2PHYCFG, dwc_rd(GUSB2PHYCFG) | saved);
+	}
+	return result;
+}
+
+/* One TRB on physical endpoint ep (0 = ep0 OUT, 1 = ep0 IN). */
+static int
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	uint32_t trb = ep ? UD_TRB_IN : UD_TRB_OUT;
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	return ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/* Local pid.codes test ID, not a production allocation. Windows uses OS2 WinUSB. */
+static const uint8_t ud_dev_desc[18]={18,1,0x10,0x02,0,0,0,64,0x09,0x12,0x01,0,0x01,0x01,1,2,3,1};
+static const uint8_t ud_cfg_desc[18]={9,2,18,0,1,1,0,0x80,250,9,4,0,0,0,0xff,0,0,0};
+static const char *const ud_strings[]={NULL,"XCover5 project","XCover5 test log","XC-AUTO-01"};
+#include "xcover5_usb_descriptors.h"
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+/* Vendor EP0 transport: 40 META,41 READ(offset32),42 ACK(meta40),43 RESET.
+ * No firmware-write command exists on this interface. */
+static void
+ud_setup(void)
+{
+    const uint8_t *st=(const uint8_t *)(ud.dma+UD_SETUP);
+    uint8_t *data=(uint8_t *)(ud.dma+UD_DATA);
+    uint8_t type=st[0],req=st[1];
+    uint16_t value=st[2]|st[3]<<8,index=st[4]|st[5]<<8,length=st[6]|st[7]<<8;
+    uint32_t n=0; bool ok=true;
+    ud.data_in=(type&0x80)!=0;ud.request=req;ud.expected=length;
+    if(type==0xc0 && req==0x20 && index==7){
+        memcpy(data,ud_ms_desc,sizeof(ud_ms_desc));n=sizeof(ud_ms_desc);
+    }else if(type==0xc0 && req==0x40 && !value && !index){
+        unsigned long state=xc_enter();memcpy(data,&xc_meta,sizeof(xc_meta));xc_leave(state);n=sizeof(xc_meta);
+    }else if(type==0xc0 && req==0x41){
+        n=xc_read_log((uint32_t)value|((uint32_t)index<<16),data,XC_CHUNK);
+    }else if(type==0x40 && req==0x42 && !value && !index && length==sizeof(xc_meta)){
+        /* Validate after OUT transfer completion, before its status stage. */
+    }else if(type==0x40 && req==0x43 && !value && !index && !length){
+        if(!xc_acknowledged)ok=false;
+        else ud.reset_ticks=1; /* Worker waits for status completion and two seconds. */
+    }else if((type&0x60)==0 && req==6 && ud.data_in){
+        switch(value>>8){
+        case 1:memcpy(data,ud_dev_desc,sizeof(ud_dev_desc));n=sizeof(ud_dev_desc);break;
+        case 2:memcpy(data,ud_cfg_desc,sizeof(ud_cfg_desc));n=sizeof(ud_cfg_desc);break;
+        case 3:n=ud_string(value&255,data);ok=n!=0;break;
+        case 15:memcpy(data,ud_bos_desc,sizeof(ud_bos_desc));n=sizeof(ud_bos_desc);break;
+        default:ok=false;
+        }
+    }else if(type==0 && req==5 && value<=127 && !length){
+        dwc_wr(DCFG,(dwc_rd(DCFG)&~(0x7fu<<3))|((uint32_t)value<<3));
+    }else if(type==0 && req==9 && value<=1 && !length){
+        printf("XCOVER5 AUTO USB: configured=%u\n",value);
+    }else if(type==0x80 && req==8){data[0]=1;n=1;
+    }else if((type&0x60)==0 && req==0 && ud.data_in){data[0]=data[1]=0;n=2;
+    }else if(type==1 && req==11 && !value && !index && !length){
+    }else{ok=false;}
+    if(!ok){ud.reset_ticks=0;ud_stall();return;}
+    if(!length){ud.state=EP0_WAIT_STATUS2;return;}
+    ud.state=EP0_DATA;
+    if(ud.data_in){if(n>length)n=length;if(ud_start(1,UD_DATA,n,TRBCTL_DATA))ud_stall();}
+    else if(ud_start(0,UD_DATA,64,TRBCTL_DATA))ud_stall();
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+            ud.reset_ticks=0;xc_acknowledged=0;
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			printf("XCOVER5 AUTO USB: bus reset\n");
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("XCOVER5 AUTO USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			ud.reset_ticks=0;xc_acknowledged=0;
+            printf("XCOVER5 AUTO USB: disconnect\n");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+            if(!ud.data_in){
+                ud_sync(UD_TRB_OUT,16);ud_sync(UD_DATA,64);
+                uint32_t remaining=*(volatile uint32_t *)(ud.dma+UD_TRB_OUT+8)&0xffffff;
+                if(ud.request!=0x42 || remaining>64 || 64-remaining!=ud.expected ||
+                   !xc_ack((const unsigned char *)(ud.dma+UD_DATA),64-remaining)){
+                    ud_stall();return;
+                }
+            }
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+        if(count>UD_EVT_SIZE || (count&3)){printf("XCOVER5 AUTO USB: invalid event count %u; stopped\n",count);return;}
+        if(ud.reset_ticks && ++ud.reset_ticks>2000 && ud.state==EP0_SETUP){
+            ud.reset_ticks=0;xcover5_download_reset();
+        }
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 12) {
+					printf("XCOVER5 AUTO USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+static void
+xcover5_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("XCOVER5 AUTO USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+
+	/* Reuse validated bootloader PHY/clock state. No Qualcomm MMIO is used. */
+    dwc_wr(GCTL,(dwc_rd(GCTL)&~(3u<<12))|(2u<<12));
+    dwc_wr(0xc200,dwc_rd(0xc200)&~(1u<<6));
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("XCOVER5 AUTO USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+	printf("XCOVER5 AUTO USB: post-reset PHYCFG=%08x\n", dwc_rd(GUSB2PHYCFG));
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("XCOVER5 AUTO USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("XCOVER5 AUTO USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
