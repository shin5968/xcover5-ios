+/* M50A: first parent transport failure only; scalar data, no user pointers. */
+static uint64_t gM50ADiag[21];
+static bool xcM50ADiagValid(const void *data,size_t n) {
+ if(!data || n!=20*sizeof(uint64_t))return false;
