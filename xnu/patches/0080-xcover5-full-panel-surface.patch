+++ b/iokit/Kernel/arm/XCoverFullPanelABI.h
@@ -0,0 +1,15 @@
+/* M48 exact full-panel variant; no arbitrary geometry or addresses. */
+#ifndef XCOVER_FULL_PANEL_ABI_H
+#define XCOVER_FULL_PANEL_ABI_H
+#define XC_FULL_BYTES (720U*1480U*4U)
+static bool xc_fb_full_swap_valid(const uint8_t *b,size_t n) {
+ if(!b || n!=0x46c)return false;
+ uint32_t id=xc_fb_word(b,0x50),sid=xc_fb_word(b,0x54);
+ if(!id || id>2 || !sid || sid>=256)return false;
+ for(unsigned i=1;i<4;i++)if(xc_fb_word(b,0x54+4*i))return false;
+ if(xc_fb_word(b,0x104)!=1 || xc_fb_word(b,0x108))return false;
+ const uint32_t rect[4]={0,0,720,1480};
+ for(unsigned i=0;i<4;i++)if(xc_fb_word(b,0x64+4*i)!=rect[i] || xc_fb_word(b,0xc4+4*i)!=rect[i])return false;
+ return true;
+}
+#endif
