+
+/* M48: exact720x1480 BGRA into validated Samsung splash mapping. */
+static unsigned xc_fb_full_presenting;
+int xcover5_full_present_begin(const uint32_t *pixels,uint32_t *saved) {
+ if(!pixels || !saved || xc_fb_stage!=4 || !fbcon_base || !xc_fb_layout_valid(&xc_fb) ||
+    xc_fb.width!=720 || xc_fb.height!=1480 || xc_fb.stride!=2880 || xc_fb.used!=4262400ULL)return 1;
+ uint64_t va=(uint64_t)(uintptr_t)fbcon_base;
+ for(uint64_t off=0;off<xc_fb.used;off+=PAGE_SIZE) {
+  ppnum_t page=pmap_find_phys(kernel_pmap,(addr64_t)(va+off));
+  if(!page || ((uint64_t)page<<PAGE_SHIFT)!=xc_fb.physical+off)return 2;
+ }
+ boolean_t enabled=xc_fb_lock();
+ if(xc_fb_presenting){xc_fb_unlock(enabled);return 3;}
+ xc_fb_presenting=xc_fb_full_presenting=1;
+ for(unsigned i=0;i<1065600;i++){saved[i]=fbcon_base[i];fbcon_base[i]=pixels[i];}
+ __sync_synchronize();xc_fb_unlock(enabled);return 0;
+}
+int xcover5_full_present_end(const uint32_t *saved) {
+ if(!saved)return 1;
+ boolean_t enabled=xc_fb_lock();
+ if(!xc_fb_presenting || !xc_fb_full_presenting){xc_fb_unlock(enabled);return 2;}
+ unsigned mismatch=0;
+ for(unsigned i=0;i<1065600;i++)fbcon_base[i]=saved[i];
+ for(unsigned i=0;i<1065600;i++)mismatch|=fbcon_base[i]!=saved[i];
+ __sync_synchronize();xc_fb_full_presenting=xc_fb_presenting=0;
+ xc_fb_unlock(enabled);return mismatch?3:0;
+}
 #endif
