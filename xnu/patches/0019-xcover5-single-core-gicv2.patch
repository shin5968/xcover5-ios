+    xc_write(xc_gicd, 0x100, (1U << 27) | (1U << SWEET_IPI_SGI));
+    xc_write(xc_gicd, 0x000, 1);
+    xc_write(xc_gicc, 0x004, 0xff);
+    xc_write(xc_gicc, 0x008, 0);
+    xc_write(xc_gicc, 0x000, 1);
+    __asm__ volatile("dsb sy; isb" ::: "memory");
+    kprintf("XCOVER5: GICv2 virtual timer IRQ27 initialized\n");
